{
  "name": "@iotactical/tak-react",
  "version": "0.2.0",
  "description": "TAK Design System React component library",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/tak-react.cjs",
  "module": "./dist/tak-react.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/tak-react.js",
      "require": "./dist/tak-react.cjs",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./dist/style.css",
    "./data/icons": "./dist/data/tak-icon-registry.json",
    "./data/icons/index": "./dist/data/icons.index.json",
    "./data/radial": "./dist/data/tak-radial-action-icons.json",
    "./data/radial/index": "./dist/data/radial.index.json",
    "./data/doctrine": "./dist/data/doctrine/ss25-control-measures.json",
    "./schemas/icons": "./dist/schemas/tak-icon-registry.schema.json",
    "./schemas/radial": "./dist/schemas/tak-radial-action-icons.schema.json",
    "./schemas/doctrine": "./dist/schemas/mil-std-2525-doctrine.schema.json"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/iotactical/tak-design-system.git"
  },
  "keywords": ["tak", "atak", "design-system", "react", "military"],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "prepublishOnly": "npm run build && npm run copy-data",
    "copy-data": "mkdir -p dist/data/doctrine dist/schemas && cp ../../data/tak-icon-registry.json ../../data/tak-radial-action-icons.json ../../data/index.json ../../data/icons.index.json ../../data/radial.index.json dist/data/ && cp ../../data/mil-std-2525/doctrine/*.json dist/data/doctrine/ && cp ../../schemas/tak-icon-registry.schema.json ../../schemas/tak-radial-action-icons.schema.json ../../schemas/mil-std-2525-doctrine.schema.json dist/schemas/"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^3.9.0"
  }
}
