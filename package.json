{
  "name": "@iotactical/tak-design-system",
  "version": "0.2.0",
  "private": true,
  "description": "TAK Design System - Design tokens and platform-specific assets for ATAK, WinTAK, TAKX, and WebTAK development",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iotactical/tak-design-system.git"
  },
  "workspaces": [
    "packages/*",
    "site"
  ],
  "scripts": {
    "build": "node scripts/build-tokens.mjs",
    "build:android": "node scripts/build-tokens.mjs --platform android",
    "build:compose": "node scripts/build-tokens.mjs --platform compose",
    "build:css": "node scripts/build-tokens.mjs --platform css",
    "build:vscode": "node scripts/build-tokens.mjs --platform vscode",
    "build:wintak": "node scripts/build-tokens.mjs --platform=wintak",
    "build:flutter": "node scripts/build-tokens.mjs --platform=flutter",
    "build:swift": "node scripts/build-tokens.mjs --platform=swift",
    "build:bridge": "node scripts/build-color-bridge.mjs",
    "build:registry": "node scripts/build-icon-registry.mjs",
    "build:react": "npm -w packages/react run build",
    "dev:react": "npm -w packages/react run dev",
    "dev:site": "npm -w site run dev",
    "build:site": "npm -w site run build",
    "clean": "rm -rf platforms/atak/res platforms/atak/compose/generated platforms/web/generated platforms/vscode/generated platforms/flutter/generated platforms/swift/generated platforms/bridge packages/react/dist",
    "pretest": "npm run build && npm run build:bridge && npm run build:registry && npm run build:react && npm run build:site",
    "test": "node --test --test-concurrency=1 tests/**/*.mjs",
    "test:rtmx": "node scripts/run-tests-rtmx.mjs",
    "test:tokens": "node --test tests/tokens/*.mjs",
    "test:build": "node --test tests/build/*.mjs",
    "test:assets": "node --test tests/assets/*.mjs",
    "validate": "node scripts/validate-tokens.mjs",
    "validate:registry": "node scripts/validate-registry.mjs",
    "package": "node scripts/package-release.mjs"
  },
  "devDependencies": {
    "playwright": "^1.60.0",
    "style-dictionary": "^4.0.0"
  },
  "dependencies": {
    "@armyc2.c5isr.renderer/mil-sym-ts": "^2.8.3",
    "canvas": "^3.2.3"
  }
}
